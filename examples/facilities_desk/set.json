     "title": "Tickets",
     "page": null,
     "parent": null,
     "statements": [
      {
       "id": "policy:1:1",
       "text": "Every ticket must have a requester.",
       "types": [],
       "modality": null,
       "source": {
        "document": "policy",
        "section": "1",
        "page": null,
        "line": 5,
        "step": 1
       },
       "quote": "Every ticket must have a requester."
      },
      {
       "id": "policy:1:2",
       "text": "Priority must be one of low, normal or urgent.",
       "types": [],
       "modality": null,
       "source": {
        "document": "policy",
        "section": "1",
        "page": null,
        "line": 6,
        "step": 2
       },
       "quote": "Priority must be one of low, normal or urgent."
      },
      {
       "id": "policy:1:3",
       "text": "Do not close a ticket that has an open child ticket.",
       "types": [],
       "modality": null,
       "source": {
        "document": "policy",
        "section": "1",
        "page": null,
        "line": 7,
        "step": 3
       },
       "quote": "Do not close a ticket that has an open child ticket."
      },
      {
       "id": "policy:1:4",
       "text": "Use good judgment when a requester is upset.",
       "types": [],
       "modality": null,
       "source": {
        "document": "policy",
        "section": "1",
        "page": null,
        "line": 8,
        "step": 4
       },
       "quote": "Use good judgment when a requester is upset."
      }
     ],
