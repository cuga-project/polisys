     },
     "quote": "Tickets"
    },
    {
     "id": "2",
     "title": "Moving an asset",
     "page": null,
     "parent": null,
     "statements": [
      {
       "id": "policy:2:1",
       "text": "When an asset moves to another building:",
       "types": [],
       "modality": null,
       "source": {
        "document": "policy",
        "section": "2",
        "page": null,
        "line": 12
       },
       "quote": "When an asset moves to another building:"
      },
      {
       "id": "policy:2:2",
       "text": "Read the asset record before changing it.",
       "types": [],
       "modality": null,
       "source": {
        "document": "policy",
        "section": "2",
        "page": null,
        "line": 13
       },
       "quote": "Read the asset record before changing it."
      },
      {
       "id": "policy:2:3",
       "text": "Update the asset record with the new building.",
       "types": [],
       "modality": null,
       "source": {
        "document": "policy",
        "section": "2",
        "page": null,
        "line": 14
       },
       "quote": "Update the asset record with the new building."
      },
      {
       "id": "policy:2:4",
       "text": "Set the asset status to in_transit until the move is confirmed.",
       "types": [],
       "modality": null,
       "source": {
        "document": "policy",
        "section": "2",
        "page": null,
        "line": 15
       },
       "quote": "Set the asset status to in_transit until the move is confirmed."
      },
      {
       "id": "policy:2:5",
       "text": "Send Template 1 to the old building manager.",
       "types": [],
       "modality": null,
       "source": {
        "document": "policy",
        "section": "2",
        "page": null,
        "line": 16
       },
       "quote": "Send Template 1 to the old building manager."
      },
      {
       "id": "policy:2:6",
       "text": "Subject: MOVE-[asset id].",
       "types": [],
       "modality": null,
       "source": {
        "document": "policy",
        "section": "2",
        "page": null,
        "line": 16
       },
       "quote": "Subject: MOVE-[asset id]."
      },
      {
       "id": "policy:2:7",
       "text": "Do not move an asset that is under audit hold.",
       "types": [],
       "modality": null,
       "source": {
        "document": "policy",
        "section": "2",
        "page": null,
        "line": 17
       },
       "quote": "Do not move an asset that is under audit hold."
      }
     ],
     "source": {
      "document": "policy",
      "section": "2",
      "page": null
     },
     "quote": "Moving an asset"
    },
    {
     "id": "3",
     "title": "Building rules",
     "page": null,
     "parent": null,
     "statements": [
      {
       "id": "policy:3:1",
       "text": "Staff must wear a badge in the building.",
       "types": [],
       "modality": null,
       "source": {
        "document": "policy",
        "section": "3",
        "page": null,
        "line": 21
       },
       "quote": "Staff must wear a badge in the building."
      },
      {
       "id": "policy:3:2",
       "text": "An audit hold is a flag on the asset record that the audit team sets.",
       "types": [],
       "modality": null,
       "source": {
        "document": "policy",
        "section": "3",
        "page": null,
        "line": 22
       },
       "quote": "An audit hold is a flag on the asset record that the audit team sets."
      },
      {
       "id": "policy:3:3",
       "text": "The audit team clears an audit hold after its review.",
       "types": [],
       "modality": null,
       "source": {
        "document": "policy",
        "section": "3",
        "page": null,
        "line": 23
       },
       "quote": "The audit team clears an audit hold after its review."
      }
     ],
     "source": {
      "document": "policy",
      "section": "3",
      "page": null
     },
     "quote": "Building rules"
    },
